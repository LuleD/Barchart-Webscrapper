# Underlying futures symbol on Barchart, e.g. GCV26 for Gold Dec 2026.
BARCHART_UNDERLYING=GCV26

# How often to poll, in seconds. Barchart itself refreshes data roughly every
# 5 minutes, so polling faster than that won't get you newer data.
POLL_INTERVAL_SECONDS=300

# Set to false to watch the browser while it runs (useful while debugging).
HEADLESS=true

# Optional escape hatch: skip automatic "find the current 1-day-to-expiration
# series" resolution and always scrape this exact volatility-greeks URL
# instead. Useful if the automatic resolver needs tuning against the live
# site, or if you'd rather pin one series manually.
# BARCHART_STATIC_SERIES_URL=https://www.barchart.com/futures/quotes/GCV26/volatility-greeks/IY8U26?futuresOptionsView=split

DATA_DIR=data

# Barchart's WAF/CloudFront blocks requests from cloud-hosting IPs outright
# (confirmed on Railway: 403 before the page even loads, valid session or
# not). Needed for any cloud deployment; not needed running locally on a
# home network. See README "IP blocking / proxy" section.
# PROXY_SERVER=http://proxy-host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=
